{"inkVersion":21,"root":[["#","^background: laboratory","/#","^You wake up in a sterile white room. Banks of monitors line the walls, displaying scrolling data you can't quite read.","\n","^A voice speaks from somewhere above: \"Welcome to the Scholastic Fair. We have a few questions for you.\"","\n","ev","str","^Look around cautiously","/str","/ev",{"*":"0.c-0","flg":20},"ev","str","^Demand to know what's going on","/str","/ev",{"*":"0.c-1","flg":20},{"c-0":["\n","ev",{"VAR?":"earnest_ironic"},1,"+",{"VAR=":"earnest_ironic","re":true},"/ev","^You scan the room methodically, taking in every detail. The voice seems to approve.","\n",{"->":"question_one"},{"->":"0.g-0"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"elitist_populist"},1,"-",{"VAR=":"elitist_populist","re":true},"/ev","^\"Who's asking?\" you call out. The voice chuckles softly.","\n",{"->":"question_one"},{"->":"0.g-0"},{"#f":5}],"g-0":["done",null]}],"done",{"question_one":[["#","^background: corridor","/#","^The room shifts. You're now standing in a long corridor that stretches into darkness in both directions.","\n","^\"If you could live forever,\" the voice asks, \"would you?\"","\n","ev","str","^Yes, absolutely","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^No, death gives life meaning","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^It depends on the terms","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"mortal_immortal"},2,"+",{"VAR=":"mortal_immortal","re":true},"/ev","^\"Interesting. You don't fear what you might become.\"","\n",{"->":"ending"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"mortal_immortal"},2,"-",{"VAR=":"mortal_immortal","re":true},"/ev","^\"A romantic notion. Perhaps wise.\"","\n",{"->":"ending"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"earnest_ironic"},1,"+",{"VAR=":"earnest_ironic","re":true},"/ev","^\"Ah, a negotiator. Fair enough.\"","\n",{"->":"ending"},{"#f":5}]}],null],"ending":["#","^background: stars","/#","#","^show: results","/#","^The corridor dissolves. You float among stars, your answers crystallizing into patterns around you.","\n","^Your constellation takes shape...","\n","end",null],"global decl":["ev",8,{"VAR=":"elitist_populist"},8,{"VAR=":"optimist_doomer"},8,{"VAR=":"earnest_ironic"},8,{"VAR=":"sovereign_symphonic"},8,{"VAR=":"anthropo_cosmo"},8,{"VAR=":"mortal_immortal"},8,{"VAR=":"vanguard_steward"},8,{"VAR=":"aligned_autonomous"},0,{"VAR=":"name_adj_index"},0,{"VAR=":"name_noun_index"},"/ev","end",null]}],"listDefs":{}}